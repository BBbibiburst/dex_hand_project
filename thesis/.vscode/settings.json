{
  "latex-workshop.latex.recipes": [
    {
      "name": "hithesis: XeLaTeX + BibTeX (local latexmk)",
      "tools": [
        "hithesis-build"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "hithesis-build",
      "command": "bash",
      "args": [
        "%WORKSPACE_FOLDER%/scripts/build.sh",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "latex-workshop.latex.autoClean.run": "never",
  "files.encoding": "utf8",
  "files.exclude": {
    "**/.tools": true,
    "**/upstream": true
  },
  "latex-workshop.synctex.path": "/home/zmy/dex_hand_project/thesis/.tools/.TinyTeX/bin/x86_64-linux/synctex"
}
